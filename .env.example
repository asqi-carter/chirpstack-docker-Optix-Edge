# These are all optional.

# API Secret (auto-generated on first deploy if not set)
# Generate your own with: openssl rand -base64 32
# CHIRPSTACK_API_SECRET=

# LoRaWAN Region (default: eu868)
# Options: eu868, us915_0-7, au915_0-7, as923, in865, kr920, ru864, cn470_0-11, etc.
# CHIRPSTACK_REGION=eu868

# Network ID (default: 000000)
# Use your assigned 3-byte NetID for production
# CHIRPSTACK_NETWORK_ID=000000

# === Port Configuration (change if conflicts) ===
# MQTT_PORT=1883
# CHIRPSTACK_HTTP_PORT=8080
# CHIRPSTACK_API_PORT=8090
# GATEWAY_UDP_PORT=1700
# GATEWAY_BASICSTATION_PORT=3001
